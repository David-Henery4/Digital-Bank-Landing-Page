---
import { Heading, BaseText } from "../../components/text";
import featuresData from "../../local-data/featuresData";
import { Image } from "astro:assets";
---

<section class="w-full section-y-padding text-center">
  <div class="grid gap-4">
    <Heading headingType="h2"> Why choose Digitalbank? </Heading>
    <BaseText>
      We leverage Open Banking to turn your bank account into your financial
      hub. Control your finances like never before.
    </BaseText>
  </div>
  <div class="mt-12 grid gap-8">
    {
      featuresData.map((featureInfo) => {
        return (
          <div class="flex flex-col justify-center items-center gap-10">
            <div>
              <Image
                src={featureInfo.icon}
                alt={featureInfo.title}
                width={72}
                height={72}
                class="object-center object-cover"
              />
            </div>
            <div class="grid gap-6">
              <Heading headingType="h3">{featureInfo.title}</Heading>
              <BaseText>{featureInfo.description}</BaseText>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
