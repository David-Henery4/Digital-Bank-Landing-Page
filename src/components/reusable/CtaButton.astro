---
interface Props {
  additionalStyles?: string[]
}
const {additionalStyles} = Astro.props
---

<button
  class="w-full overflow-hidden max-w-40 mx-auto relative px-8 py-2 rounded-1xl text-white text-preset-7-bold bg-gradient-1 hover:cursor-pointer hover:after:pointer-events-none hover:after:absolute hover:after:top-0 hover:after:left-0 hover:after:w-full hover:after:h-full hover:after:bg-white/40 active:hover:after:hidden"
  class:list={additionalStyles}
>
  Request Invite
</button>
