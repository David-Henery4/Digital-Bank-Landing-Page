---
interface Props {
  textType?: "sm" | "md" | "lg";
  optionalStyles?: string[];
}
const { textType = "sm", optionalStyles = [""] } = Astro.props;

const handleTextStyles = (textType: "sm" | "md" | "lg") => {
  if (textType === "md") {
    // larger screens: text-preset-6-light // 16px
    return ["text-preset-7-regular mobile-md:text-preset-6-light"]; // start on 14px
  }

  if (textType === "lg") {
    // larger screens: text-preset-5-regular // 18px
    return ["text-preset-7-regular mobile-md:text-preset-5-regular"]; // start on 14px
  }

  return ["text-preset-7-regular"]; // 14px
};
---

<p
  class="text-gray-600"
  class:list={[...handleTextStyles(textType), ...optionalStyles]}
>
  <slot />
</p>
